{
  "name": "rezyume",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,api -c green,cyan \"pnpm dev:web\" \"pnpm server:dev\"",
    "dev:web": "next dev --turbopack --port 7009",
    "build": "next build",
    "start": "next start --port 7009",
    "lint": "eslint . --max-warnings 0",
    "lint-fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "pnpm --filter rezyume-server exec tsc --noEmit",
    "fonts:css": "node scripts/fonts/build-css.mjs",
    "verify": "pnpm typecheck && pnpm typecheck:server && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter rezyume-server run db:deploy",
    "db:seed": "pnpm --filter rezyume-server run db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "server:dev": "pnpm --filter rezyume-server dev"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.1",
    "antd-img-crop": "^4.30.0",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "next": "^16.3.1",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.6",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix --no-warn-ignored"
    ]
  }
}
