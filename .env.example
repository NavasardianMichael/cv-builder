# The web app's env. `pnpm install` copies this file to .env.local when that is missing.
# Every NEXT_PUBLIC_* value is inlined into the bundle at BUILD time: changing one needs a
# rebuild, and none may hold a secret. Production values come from deploy.yml's secrets/vars.
# The API has its own file: server/.env.example.

# Backend origin (the Express API in server/). Must equal the API's API_PUBLIC_URL.
NEXT_PUBLIC_API_URL=http://localhost:9009

# Public origin of this app — the host that serves the pages. Used for metadataBase,
# canonicals, the sitemap and every JSON-LD `url`/`@id`. Must equal the API's CORS_ORIGIN.
NEXT_PUBLIC_SITE_URL=http://localhost:7009

# --- Optional; each empty = that feature off (the default in dev) ----------------
# Sentry error reporting — web only, the API has none: the project's DSN. src/helpers/sentry.ts
NEXT_PUBLIC_SENTRY_DSN=
# Google Analytics 4 measurement id, G-XXXXXXXXXX. src/helpers/analytics.ts
NEXT_PUBLIC_GA_ID=
# Google Search Console's ownership tag (the content="…" value only). src/constants/seo.ts
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Production only — do NOT set these locally ------------------------------------
# Set as GitHub Actions secrets; the deploy build uses them. Optional: without them errors
# still reach Sentry, only their stack traces show minified code instead of the source.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
