# The API's env. Read only by src/config.ts (+ src/load-env.ts, which loads, highest first:
# .env.<NODE_ENV>.local > .env.local > .env.<NODE_ENV> > .env). `pnpm install` copies this file
# to server/.env when that is missing. Production: server/.env.production.local, shipped as the
# ENV_API_BASE64 secret (`pnpm env:base64 production`) — every key here except the last section.

# --- Database -----------------------------------------------------------------
# docker-compose.yml publishes Postgres on 5009. Production: 127.0.0.1 (never localhost) and
# the password from $APP_DIR/db/.env — see deployment/db.env.example.
DATABASE_URL="postgresql://cv-builder:cv-builder@localhost:5009/cv-builder?schema=public"

# Signs the session JWT and the Google OAuth state cookie. `openssl rand -hex 64`.
# Rotating it signs every user out.
JWT_SECRET="change-me-in-production-use-long-random-string"

# The exact origin serving the web app, no trailing slash — equal to the web's
# NEXT_PUBLIC_SITE_URL. CORS allows only it and requireSameOrigin compares against it.
CORS_ORIGIN="http://localhost:7009"

# The session cookie's Domain. Leave unset: it is derived (src/lib/cookie-domain.ts) — host-only
# in dev, CORS_ORIGIN's hostname in production, which covers the api. host beneath it. Set it
# only if the API is not a subdomain of the web host; "" forces a host-only cookie.
# COOKIE_DOMAIN=""

# The API's own public origin — equal to the web's NEXT_PUBLIC_API_URL. The payment gateway
# sends the buyer back here (/payments/return/<gateway>).
API_PUBLIC_URL="http://localhost:9009"

# "true" runs Chrome without its sandbox: a container running as root, or a host whose
# AppArmor blocks the sandbox (docs/PRODUCTION_SETUP.md step 2). Leave unset locally.
# PUPPETEER_NO_SANDBOX="true"

# --- Mail engine -----------------------------------------------------------------
# Sends sign-up verification, password-reset and "password changed" mail, and the contact
# form. Empty in dev: links and messages print to this console instead. Required in
# production — without it a password sign-up can never be verified, and the contact form
# answers 503.
MAIL_API_URL=""
MAIL_API_KEY=""

# --- Google OAuth ---------------------------------------------------------------
# Google Cloud console > Credentials > OAuth client ID (Web application).
# Authorized redirect URI, exactly: http://localhost:9009/identity/google/callback
# (production: https://api.<domain>/identity/google/callback). Scopes: email, profile.
# Leave both empty to run without Google: the web app hides the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:9009/identity/google/callback"

# --- Payments -------------------------------------------------------------------
# `mock` (dev default: a fake payment page served by this API) or `ameria`.
# `mock` is refused when NODE_ENV=production. See docs/PAYMENTS.md.
PAYMENT_GATEWAY="mock"

# Ameriabank vPOS 3.1. Credentials come from the bank (vpos.support@ameriabank.am).
AMERIA_CLIENT_ID=""
AMERIA_USERNAME=""
AMERIA_PASSWORD=""
# Only the exact value "false" uses the live terminal; anything else, unset included, uses
# servicestest.ameriabank.am. The test terminal only accepts 10 AMD and an OrderID inside the
# range the bank assigns, hence the two settings below.
AMERIA_TEST_MODE="true"
# OrderID sent to the bank = this + Payment.orderNumber. Set it to the start of the range
# the bank gave you.
AMERIA_ORDER_ID_OFFSET="0"
# Overrides the charged amount in whole drams. Set to 10 in test mode, leave unset live.
# AMERIA_AMOUNT_OVERRIDE="10"

# --- Local dev only (production: written by the deploy — leave these out there) -----
PORT=9009
# Interface to listen on; defaults to every one (0.0.0.0). Production: 127.0.0.1.
# HOST=127.0.0.1
NODE_ENV=development
# Where headless Chrome opens the web app's /render page to print a PDF. Defaults to
# CORS_ORIGIN. Production: http://127.0.0.1:7009, the web process over loopback.
# RENDER_ORIGIN="http://127.0.0.1:7009"
