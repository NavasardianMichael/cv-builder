            "font": null
          }
        },
        {
          "id": "f587c8705841",
          "type": "experience",
          "title": "Աշխատանքային փորձ",
          "hidden": false,
          "column": "auto",
          "text": "",
          "entries": [
            {
              "id": "c434e3a5caac",
              "title": "Ավագ արտադրանքի դիզայներ",
              "subtitle": "Արարատ Տեխ",
              "period": "2021 – այժմ",
              "location": "Երևան",
              "description": "• Ղեկավարել եմ բջջային բանկինգի հավելվածի վերանախագծումը՝ 1,2 մլն օգտատեր\n• Կրճատել եմ վճարման քայլերը 5-ից 2-ի, ինչը 18%-ով բարձրացրեց փոխարկումը\n• Ստեղծել և պահպանում եմ ընկերության դիզայն համակարգը"
            },
            {
              "id": "c23babbfe6f3",
              "title": "UX/UI դիզայներ",
              "subtitle": "Սևան Դիջիթալ",
              "period": "2018 – 2021",
              "location": "Երևան",
              "description": "• Նախագծել եմ 20+ վեբ և բջջային ինտերֆեյս տեղական և միջազգային հաճախորդների համար\n• Անցկացրել եմ օգտատերերի հարցազրույցներ և օգտագործելիության թեստեր"
            }
          ],
