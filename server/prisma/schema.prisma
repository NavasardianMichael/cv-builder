generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An account. Signs in with a password, Google, or both.
model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  fullName               String
  /// Null for a Google-only account.
  passwordHash           String?
  googleId               String?   @unique
  avatarUrl              String?
  /// Set when the inbox was proven: Google vouched for it, or the owner opened an emailed
  /// link (verification or password reset). A password account cannot sign in until it is
  /// set (routes/identity.ts), and Google linking claims an account where it is not
  /// (routes/identity-google.ts).
  emailVerifiedAt        DateTime?
  /// The pending verification link (hashed, like the reset token). Cleared once used.
  emailVerifyTokenHash   String?   @unique
  emailVerifyExpiresAt   DateTime?
  /// Bumped by password reset/change and account delete; every session cookie minted
  /// against an older value stops being honoured (middleware/auth.ts).
  tokenVersion           Int       @default(0)
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  cvs      Cv[]
  payments Payment[]
}

/// One CV document. `content` and `design` are JSON coerced by services/cvDocument.ts on
/// every write: the shape is the web's `CvContent` / `CvDesign`.
///
/// Owned by an account (`userId`) or, when bought without one, by a browser's guest key
/// (`guestKeyHash`, lib/guest.ts) — exactly one of the two, enforced by a CHECK constraint
/// in the migration. Signing in moves a guest's CVs to the account.
model Cv {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the guest cookie's key; the key itself is never stored.
  guestKeyHash String?
  title        String
  /// Denormalised from `design.templateId` for listing without parsing JSON.
  templateId   String
  content      Json
  design       Json
  /// Set once, by a settled payment. A paid CV stays downloadable and editable forever.
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payments  Payment[]
  downloads PdfDownload[]

  @@index([userId, updatedAt])
  @@index([guestKeyHash, updatedAt])
}

enum PaymentStatus {
  pending
  succeeded
  failed
  /// Was `succeeded`, then refunded or voided in the bank's panel; the CV keeps `paidAt` only
  /// while another payment of it is still `succeeded`.
  refunded
}

enum PaymentGateway {
  ameria
  mock
}

/// One checkout attempt for one CV. Kept when the CV or the account is deleted: it is the
/// accounting record, so both links are nullable.
model Payment {
  id               String         @id @default(cuid())
  /// The integer order number a gateway needs (Ameria's `OrderID`, plus an offset).
  orderNumber      Int            @unique @default(autoincrement())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  cvId             String?
  cv               Cv?            @relation(fields: [cvId], references: [id], onDelete: SetNull)
  /// Whole drams.
  amount           Int
  currency         String         @default("AMD")
  gateway          PaymentGateway
  gatewayPaymentId String?        @unique
  status           PaymentStatus  @default(pending)
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  downloads PdfDownload[]

  @@index([cvId, status])
}

/// One designed PDF the server sent in full (`GET /cvs/:id/pdf`, routes/cvs.ts): the proof,
/// next to the payment's, that a paid CV was delivered — what the refund policy's "could not
/// download it" claim is checked against. Written once the last byte is handed to the
/// connection; a print that failed or a client that hung up first leaves no row. The free
/// black-and-white PDF is not recorded. Kept, like `Payment`, when the CV or account goes.
model PdfDownload {
  id        String   @id @default(cuid())
  cvId      String?
  cv        Cv?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  /// The `succeeded` payment the download was served under.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  bytes     Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([cvId, createdAt])
  @@index([paymentId])
}
